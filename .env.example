# Adzuna API — free tier, sign up at https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Anthropic — for AI scoring (supports both claude-sonnet-4-6 and claude-opus-4-5)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# Gmail SMTP for daily digest emails
# IMPORTANT: Use a 16-character Google App Password, NOT your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
DIGEST_TO_EMAIL=your@gmail.com

# Slack integration for tailored resume notifications (optional)
# SLACK_WEBHOOK_URL: For posting formatted messages
# SLACK_BOT_TOKEN: For uploading resume files (xoxb-...)
# SLACK_CHANNEL_ID: Channel where resumes should be posted
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Resume contact info — overrides the placeholder values in data/base-resume.json
RESUME_EMAIL=your@email.com
RESUME_PHONE=000-000-0000
RESUME_GITHUB=github.com/yourusername
RESUME_LINKEDIN=linkedin.com/in/yourusername

# Server
PORT=3001
